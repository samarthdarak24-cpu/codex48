# ==============================================================================
# PRECEDENT — Master Environment Configuration Template (.env.example)
# Copy this file to .env (or backend/.env) and customize for your environment.
# All variables have safe local defaults that work out of the box with zero external setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
APP_ENV=development
SECRET_KEY=dev-secret-change-me-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALLOW_SELF_REGISTRATION=true
SEED_PASSWORD=precedent

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# Default: SQLite (portable, runs immediately without Docker or Postgres installed)
DATABASE_URL=sqlite:///./precedent.db

# For PostgreSQL (Docker or production):
# DATABASE_URL=postgresql+psycopg://precedent:precedent_password@localhost:5432/precedent
USE_PGVECTOR=false

# ------------------------------------------------------------------------------
# 3. CORS & Networking
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_ORIGIN=http://127.0.0.1:5173
VITE_API_BASE=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 4. Storage & Uploads
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=25
MALWARE_SCAN=off

# ------------------------------------------------------------------------------
# 5. Background Jobs & Scheduler
# ------------------------------------------------------------------------------
# Set to 'true' to run background jobs synchronously in-process (recommended for tests/dev)
# Set to 'false' when running the dedicated background worker process (python -m app.workers.worker)
JOBS_INLINE=true
SENTINEL_CRON=0 0 * * *

# ------------------------------------------------------------------------------
# 6. Analytics & Sample Size Guards
# ------------------------------------------------------------------------------
LOW_SAMPLE_THRESHOLD=20

# ------------------------------------------------------------------------------
# 7. AI & LLM Advisory Configuration (Optional)
# When left unset, all AI advisory features gracefully degrade to deterministic fallback.
# Base deterministic rule checks, OCR, and color distance algorithms operate at 100%.
# ------------------------------------------------------------------------------
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
RETRIEVAL_MODE=hybrid
RERANKER_ENABLED=false

# ------------------------------------------------------------------------------
# 8. External Asset Source (Optional)
# ------------------------------------------------------------------------------
IMAGE_SOURCE_API_URL=
IMAGE_SOURCE_API_KEY=
