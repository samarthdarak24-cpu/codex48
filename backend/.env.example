# Precedent — environment variables
#
# Copy to .env (backend/.env) and fill in only what you need.
# Every value below is a SAFE PLACEHOLDER. No real credentials belong in this file.
# Nothing here is required to run the demo: the defaults produce a working
# SQLite + BM25 + Tesseract installation with no AI provider configured.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_NAME=Precedent

# SQLite by default so the app runs with zero setup.
# PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME  (then: alembic upgrade head)
DATABASE_URL=sqlite:///./precedent.db

# Sign JWTs. MUST be replaced before any shared deployment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me

# Access-token lifetime in minutes (12 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated allowed origins for the browser app.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Where uploaded posters/guidelines/assets are written.
UPLOADS_DIR=uploads

# ---------------------------------------------------------------------------
# AI (optional). Leave blank and the deterministic rule engine is the only
# source of truth; AI suggestions simply do not appear.
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_DAILY_CALL_LIMIT=500

# ---------------------------------------------------------------------------
# A2 Evidence Intelligence — retrieval
# ---------------------------------------------------------------------------
# Leave the ONNX paths blank to use the bundled model under backend/models/
# (multilingual-e5-small, falling back to paraphrase-multilingual-MiniLM-L12-v2).
# Point them elsewhere to use your own sentence-transformer export.
EMBEDDING_ONNX_PATH=
EMBEDDING_TOKENIZER_PATH=
# Legacy token->vector table (optional, only if you are not using ONNX).
EMBEDDING_MODEL=
EMBEDDING_MODEL_PATH=
RETRIEVAL_TOP_K=5
# Below this confidence a finding becomes "needs review", never a violation.
AI_CONFIDENCE_THRESHOLD=0.6

# ---------------------------------------------------------------------------
# A1 VisualGuard
# ---------------------------------------------------------------------------
# Comma-separated Tesseract language packs. Only packs actually installed are used.
OCR_LANGS=eng
# Windows default. On Linux/Docker leave empty and put tesseract on PATH.
TESSERACT_CMD=
MAX_UPLOAD_MB=10
# Minimum ORB match score before a logo is treated as present.
LOGO_MATCH_THRESHOLD=0.62

# ---------------------------------------------------------------------------
# A3 Sentinel
# ---------------------------------------------------------------------------
# Daily in-process sweep time (UTC).
SENTINEL_CRON=02:00
# Days a reassessment task is allowed to stay open before it is overdue.
SENTINEL_SLA_DAYS=3
# Set to false on every worker but one in a multi-worker deployment.
# The scan itself is idempotent, so a double run cannot create duplicate tasks.
SENTINEL_SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Optional integrations (guarded — never required)
# ---------------------------------------------------------------------------
IMAGE_SOURCE_API_URL=
IMAGE_SOURCE_API_KEY=
USE_PGVECTOR=false

# ---------------------------------------------------------------------------
# Frontend (Vite). Set in the project root .env if the API is not on :8000
# ---------------------------------------------------------------------------
VITE_API_BASE=http://127.0.0.1:8000
