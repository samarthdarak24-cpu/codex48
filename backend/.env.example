# Copy to .env and adjust. All values are optional except where noted.

# Database: SQLite by default (works out of the box). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/precedent
DATABASE_URL=sqlite:///./precedent.db

# Auth signing key — CHANGE THIS in any real deployment.
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS origins (comma-separated). The Vite dev server:
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Uploaded files (guidelines, brand/product images) land here.
UPLOADS_DIR=uploads

# Optional AI. When empty, AI features degrade gracefully (deterministic only).
# Use any OpenAI-compatible /v1/chat/completions endpoint.
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Optional official product-image source (guarded; not required).
# IMAGE_SOURCE_API_URL=
# IMAGE_SOURCE_API_KEY=

# Optional pgvector (Postgres only).
USE_PGVECTOR=false
